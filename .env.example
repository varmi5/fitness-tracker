# ==============================================================================
# 1. CORE / REQUIRED (minimum needed to boot with `docker compose up -d`)
# ==============================================================================
# Bundled Postgres credentials (used by docker-compose.yml)
POSTGRES_USER=fitness
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=fitness

# Used automatically by `docker-compose.yml`. For manual/external Postgres set:
# DATABASE_URL=postgresql://fitness:password@localhost:5432/fitness
DATABASE_URL=

# Public origin visitors use (use https://... in production for Passkeys, PWA, and MCP OAuth)
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extra HTTPS origins allowed alongside BETTER_AUTH_URL during dual-domain migrations:
ALLOWED_ORIGINS=
# Optional: set true after cutover to 301-redirect browser GET visits on secondary hosts to BETTER_AUTH_URL
# (never redirects /api/, /mcp, /oauth/, or /.well-known/):
REDIRECT_LEGACY_WEB_TO_PRIMARY=false

# At least 32 random chars (`openssl rand -hex 32`)
BETTER_AUTH_SECRET=

# closed (owner-only), invite (requires INVITE_CODE), or open (requires Resend + Turnstile)
SIGNUP_MODE=closed

# At least 24 printable ASCII chars (`openssl rand -hex 24`) to create the initial owner at /setup.
# Clear or remove this variable after completing initial setup.
SETUP_CODE=

# Optional port override for docker-compose.yml
APP_PORT=3000

# ==============================================================================
# 2. CHATGPT / MCP CONNECTOR (optional)
# ==============================================================================
FITNESS_MCP_ENABLED=false
# Optional public MCP base URL (defaults to BETTER_AUTH_URL). Pin to the legacy host during domain migrations:
MCP_PUBLIC_URL=
# Set only when verifying ownership for a public OpenAI ChatGPT directory listing:
OPENAI_APPS_CHALLENGE=

# ==============================================================================
# 3. INTEGRATIONS (all optional — only needed for the services you connect)
# ==============================================================================
# Required if enabling Google Health, Hevy OAuth, or encrypted integration credentials:
# 64 hex chars (`openssl rand -hex 32`)
FITNESS_INTEGRATION_KEY=

# Google Health / Fitbit Air OAuth (redirect URI: <BETTER_AUTH_URL>/api/integrations/google/callback)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_WEBHOOK_SECRET=
GOOGLE_HEALTH_WEBHOOK_VERIFY_SIGNATURE=false

# Hevy API OAuth & webhooks (CSV/JSON import works on Hevy Free without these)
HEVY_CLIENT_ID=
HEVY_CLIENT_SECRET=
HEVY_WEBHOOK_SECRET=
# HEVY_AUTHORIZE_URL=
# HEVY_TOKEN_URL=

# Open Wearables beta companion (Apple Health, Health Connect, Garmin, Oura, WHOOP)
OPEN_WEARABLES_API_URL=
OPEN_WEARABLES_API_KEY=
OPEN_WEARABLES_DEVELOPER_EMAIL=
OPEN_WEARABLES_DEVELOPER_PASSWORD=
OPEN_WEARABLES_WEBHOOK_SECRET=

# ==============================================================================
# 4. SIGNUP, EMAIL, BOT PROTECTION & PUSH REMINDERS (optional)
# ==============================================================================
INVITE_CODE=
RESEND_API_KEY=
EMAIL_FROM=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Web Push VAPID keys for PWA meal/weigh-in reminders (`npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ==============================================================================
# 5. OWNER FEEDBACK HANDOFFS (optional — see docs/feedback.md)
# ==============================================================================
CANNY_API_KEY=
CANNY_FEEDBACK_BOARD_ID=
CANNY_FEEDBACK_AUTHOR_ID=
FEEDBACK_GITHUB_TOKEN=
