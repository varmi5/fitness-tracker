{
  "name": "fitness-tracker",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "esbuild scripts/service-worker.ts --bundle --minify --outfile=public/sw.js && esbuild scripts/set-password.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/set-password.mjs && next build",
    "start": "node .next/standalone/server.js",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:ui": "node tests/mobile-smoke.mjs"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.23",
    "@better-auth/passkey": "1.7.23",
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/postcss": "4.3.5",
    "better-auth": "1.7.23",
    "drizzle-orm": "0.45.4",
    "jose": "^6.2.17",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "serwist": "9.5.13",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
