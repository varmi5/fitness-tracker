{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mcp-logger": {
      "type": "streamable-http",
      "url": "https://fitness.hadamardsecurities.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "fitness:read"
            ],
            "defaultScopes": [
              "fitness:read",
              "fitness:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
